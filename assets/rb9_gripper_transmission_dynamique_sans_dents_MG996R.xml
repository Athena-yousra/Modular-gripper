  <!-- ===================================================================
       TRANSMISSION PIGNON-CRÉMAILLÈRE (sans simulation dent par dent)
       ===================================================================
       On impose la relation cinématique exacte x = r*theta au niveau
       POSITION par une contrainte d'égalité holonome (equality/joint),
       résolue par le solveur de contraintes de MuJoCo (multiplicateurs
       de Lagrange), et non par une force de rappel explicite (ressort).

       Différence essentielle avec la tentative "fixed tendon + ressort
       raide" : ici, la force nécessaire pour maintenir x = r*theta est
       calculée implicitement à chaque pas à partir de la matrice de
       masse complète du système (moteur + 2 crémaillères), et non à
       partir d'un coefficient de raideur K fixé arbitrairement. Cela
       évite la sur-raideur numérique (K_theta ~ 15 N.m/rad) qui
       bridait le moteur dans la version à ressort.

       Convention de signe (pignon vu de dessus, rotation +z) :
         x_R = + r * theta   (crémaillère droite)
         x_L = - r * theta   (crémaillère gauche)
       -> à vérifier/inverser une fois sur la géométrie réelle si le
          sens d'ouverture/fermeture ne correspond pas au maillage.

       solref/solimp : voir "Paramètres à calibrer" dans la réponse.
       Valeurs de départ volontairement plus rigides que les valeurs
       MuJoCo par défaut, mais SANS commune mesure avec un ressort de
       180000 N/m : ce sont des paramètres numériques de solveur, pas
       une raideur physique. -->
  <equality>
    <joint name="eq_rack_right" joint1="right_slide" joint2="motor_joint"
           polycoef="0 0.0065 0 0 0"
           solref="0.002 1" solimp="0.95 0.99 0.0002"/>
    <joint name="eq_rack_left" joint1="left_slide" joint2="motor_joint"
           polycoef="0 -0.0065 0 0 0"
           solref="0.002 1" solimp="0.95 0.99 0.0002"/>
  </equality>

<actuator>
    <!-- Commande du servomoteur MG996R.
         La position est commandée en radians et l'effort est saturé à ±0.92 N.m.
         La charge générée par les contacts sur les crémaillères est renvoyée
         à la transmission analytique par les contraintes d'égalité. -->
    <position name="motor_pos_ctrl" joint="motor_joint" kp="5"
              ctrlrange="-12.566 12.566"
              forcelimited="true" forcerange="-0.92 0.92"/>
  </actuator>

  <keyframe>
    <key name="nominal" qpos="0 0 0"/>
  </keyframe>

