 <mujoco model="kuka_rb9_gripper_scene">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <asset>
    <material name="red_material" rgba="0.8 0.1 0.1 1.0"/>
    <mesh name="lego_mesh" file="lego.stl" scale="0.002 0.002 0.002"/>
  </asset>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <!-- Main arm file -->
  <include file="kuka_arm.xml"/>

  <!-- Standalone Sensor Inclusion (keep only ones not included elsewhere) -->
  <include file="ultrasonic_sensor.xml"/>

  <worldbody>
    <light name="top" pos="0 0 2" mode="trackcom"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.9 0.8 1"/>

    <!-- Work Table -->
    <geom name="table" type="box" pos="0.75 0.0 0.20" size="0.30 0.40 0.20" rgba="0.7 0.7 0.8 1"/>

    <!-- Lego Object -->
    <body name="lego_piece" pos="0.7 -0.01 0.43">
      <freejoint name="lego_freejoint"/>
      <geom name="lego_geom" type="mesh" mesh="lego_mesh" material="red_material" mass="0.025"
            friction="2.5 0.005 0.0001" solref="0.001 1" solimp="0.99 0.99 0.001"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
         qpos="0 0.785398 0 -1.5708 0 0 0  0 0 0  0.75 0.0 0.43 1 0 0 0"
         ctrl="0 0.785398 0 -1.5708 0 0 0 0"/>
  </keyframe>
</mujoco>
